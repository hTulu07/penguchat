# Maintainer: Huseyin Tulu <192036673+hTulu07@users.noreply.github.com>
pkgname=penguchat
pkgver=1.1.0
pkgrel=1
pkgdesc="A small, native-feeling WhatsApp Web desktop app for Linux"
arch=('any')
url="https://github.com/hTulu07/penguchat"
license=('MIT')
depends=('python' 'python-pyqt6' 'python-pyqt6-webengine')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('cbd9bc3dea28458ff54852061d643231b0b7c94fffa882fa5d26cf1c54559b6d')

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 penguchat.py "$pkgdir/usr/bin/penguchat"
  install -Dm644 data/io.github.htulu07.Penguchat.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/io.github.htulu07.Penguchat.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 data/io.github.htulu07.Penguchat.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
